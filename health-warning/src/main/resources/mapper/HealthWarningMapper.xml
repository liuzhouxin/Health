<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.warning.mapper.HealthWarningMapper">

    <resultMap id="WarningCountMap" type="com.health.warning.entity.WarningCountVO">
        <result column="total" property="total"/>
        <result column="critical_count" property="criticalCount"/>
        <result column="high_count" property="highCount"/>
        <result column="medium_count" property="mediumCount"/>
        <result column="low_count" property="lowCount"/>
        <result column="unhandled_count" property="unhandledCount"/>
    </resultMap>

    <select id="selectWarningCountByUserId" resultMap="WarningCountMap">
        SELECT COUNT(*) AS total,
               SUM(CASE WHEN warning_level = 'critical' THEN 1 ELSE 0 END) AS critical_count,
               SUM(CASE WHEN warning_level = 'high' THEN 1 ELSE 0 END) AS high_count,
               SUM(CASE WHEN warning_level = 'medium' THEN 1 ELSE 0 END) AS medium_count,
               SUM(CASE WHEN warning_level = 'low' THEN 1 ELSE 0 END) AS low_count,
               SUM(CASE WHEN is_handled = 0 THEN 1 ELSE 0 END) AS unhandled_count
        FROM health_warning
        WHERE user_id = #{userId}
    </select>

    <resultMap id="WarningMap" type="com.health.warning.entity.HealthWarning">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="record_id" property="recordId"/>
        <result column="report_item_id" property="reportItemId"/>
        <result column="warning_type" property="warningType"/>
        <result column="warning_level" property="warningLevel"/>
        <result column="warning_content" property="warningContent"/>
        <result column="warning_value" property="warningValue"/>
        <result column="threshold_min" property="thresholdMin"/>
        <result column="threshold_max" property="thresholdMax"/>
        <result column="is_handled" property="isHandled"/>
        <result column="handle_time" property="handleTime"/>
        <result column="handler" property="handler"/>
        <result column="handle_remark" property="handleRemark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectWarningsByUserId" resultMap="WarningMap">
        SELECT * FROM health_warning
        WHERE user_id = #{userId}
        <if test="warningLevel != null and warningLevel != ''">
            AND warning_level = #{warningLevel}
        </if>
        <if test="isHandled != null">
            AND is_handled = #{isHandled}
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>